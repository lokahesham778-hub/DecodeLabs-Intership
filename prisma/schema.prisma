generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  age       Int
  is_active Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Movie {
  id        Int      @id @default(autoincrement())
  title     String
  year      Int
  director  String?
  genre     String
  rating    Float?
  status    String   @default("plan")
  notes     String?
  createdAt DateTime @default(now())
}